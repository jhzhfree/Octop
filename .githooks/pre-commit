#!/usr/bin/env bash
# Pre-commit gate: make precommit (format BE+FE + lint + typecheck + testmon-scoped
# tests) + dashboard build. The full suite still runs in CI (`make all`); this is a
# fast, change-aware local gate so commits don't wait on the whole test matrix.
# Install once per clone: make install-hooks (checks default to off)
# Switch checks on/off: make enable-precommit / make disable-precommit
# Bypass an enabled gate once: SKIP_PRECOMMIT=1 git commit ...
# Or: git commit --no-verify
set -euo pipefail

if [[ "${SKIP_PRECOMMIT:-}" == "1" ]]; then
  echo "[pre-commit] SKIP_PRECOMMIT=1 — skipping checks"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Repository-local opt-in. Unset means off; invalid boolean values must fail.
if PRECOMMIT_ENABLED="$(git config --bool --get octop.precommitEnabled)"; then
  :
else
  config_status=$?
  if [[ "$config_status" != "1" ]]; then
    exit "$config_status"
  fi
  PRECOMMIT_ENABLED=false
fi
if [[ "$PRECOMMIT_ENABLED" != "true" ]]; then
  echo "[pre-commit] Checks disabled (enable with: make enable-precommit)"
  exit 0
fi

# Documentation-only commits do not need code checks or a dashboard build.
# Include deletions and both sides of renames when deciding what changed.
DOCS_ONLY=1
HAS_CHANGES=0
while IFS= read -r -d '' path; do
  HAS_CHANGES=1
  case "$path" in
    README.md|README.*.md) ;;
    *) DOCS_ONLY=0 ;;
  esac
done < <(git diff --cached --name-only --no-renames -z)
if [[ "$HAS_CHANGES" == "1" && "$DOCS_ONLY" == "1" ]]; then
  echo "[pre-commit] Documentation-only changes — skipping code checks and dashboard build"
  exit 0
fi

# Remember staged paths so we can re-add them after auto-format rewrites the worktree.
# Portable (bash 3.2+): avoid `mapfile` (bash 4+ only).
STAGED_FILES=()
while IFS= read -r line; do
  [[ -n "$line" ]] && STAGED_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR || true)

if command -v make >/dev/null 2>&1; then
  echo "[pre-commit] make precommit  (format-all + lint + typecheck + testmon-scoped test)"
  make precommit
else
  # Windows / minimal shells often lack GNU make. Run the same gate inline:
  # format-all (ruff --fix + prettier write) → lint → typecheck → testmon tests.
  echo "[pre-commit] make not found — running the precommit gate inline"
  echo "[pre-commit] format-all + lint + typecheck + testmon-scoped test"

  # Prefer uv, then the project venv (POSIX or Windows layout), then PATH.
  py_tool() {
    if command -v uv >/dev/null 2>&1; then
      uv run "$@"
    elif [[ -x .venv/Scripts/python.exe ]]; then
      .venv/Scripts/python.exe -m "$@"
    elif [[ -x .venv/bin/python ]]; then
      .venv/bin/python -m "$@"
    else
      "$@"
    fi
  }

  echo "[pre-commit] format (backend)"
  py_tool ruff check --fix src tests
  py_tool ruff format src tests

  if [[ -d dashboard/node_modules ]]; then
    echo "[pre-commit] format (frontend)"
    (cd dashboard && npm run format)
  else
    echo "[pre-commit] WARN dashboard/node_modules missing — skipping frontend format (run: cd dashboard && npm ci)"
  fi

  echo "[pre-commit] lint (backend)"
  py_tool ruff check src tests
  py_tool ruff format --check src tests

  echo "[pre-commit] typecheck (backend)"
  py_tool mypy src/octop

  if [[ -f .testmondata ]]; then
    echo "[pre-commit] test (testmon: affected tests only)"
  else
    echo "[pre-commit] test (testmon: no cache yet — this run covers the full suite)"
  fi
  py_tool pytest --testmon
fi

# If format rewrote files that were already staged, refresh the index so the
# commit includes the formatted content (worktree vs index drift).
if ((${#STAGED_FILES[@]} > 0)); then
  existing=()
  for f in "${STAGED_FILES[@]}"; do
    if [[ -e "$f" || -L "$f" ]]; then
      existing+=("$f")
    fi
  done
  if ((${#existing[@]} > 0)); then
    git add -- "${existing[@]}"
  fi
fi

echo "[pre-commit] dashboard npm run build"
if [[ -d "$ROOT/dashboard/node_modules" ]]; then
  (
    cd "$ROOT/dashboard"
    npm run build
  )
else
  echo "[pre-commit] WARN dashboard/node_modules missing — skipping dashboard build (run: cd dashboard && npm ci)"
fi

echo "[pre-commit] all checks passed"
