{
  "name": "@akb/agent-identity-sdk",
  "version": "0.4.0",
  "license": "MIT",
  "description": "Platform independent Agent identity, protected per-Agent keys and AKB request proofs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./keystore-node": {
      "types": "./dist/keystore-node.d.ts",
      "default": "./dist/keystore-node.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "default": "./dist/registration.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "bin": {
    "akb-agent-identity": "dist/cli.js",
    "akb-agent-identity-bridge": "dist/bridge.js"
  },
  "files": [
    "dist",
    "README.md",
    "config.example.json",
    "config.bootstrap.example.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node test/live.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/node": "^22.0.0"
  },
  "dependencies": {
    "@akb/agent-keygen": "file:../../tools/agent-keygen"
  },
  "bundledDependencies": [
    "@akb/agent-keygen"
  ]
}
